# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ayupulse

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5174","http://127.0.0.1:5174"]

# Application Settings
PROJECT_NAME=AyuPulseApp
DEBUG=True

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/jpg"]

# ML Model Paths (if using pre-trained models)
XRAY_MODEL_PATH=./ml/models/xray_model.pth
ECG_MODEL_PATH=./ml/models/ecg_model.pth
CLINICAL_MODEL_PATH=./ml/models/clinical_model.pkl

# Optional: Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ayupulse.com