# Production Environment Variables for Railway Deployment
# Copy these to Railway environment variables

# MongoDB Atlas Connection (replace with your actual connection string)
MONGODB_URL=mongodb+srv://username:password@cluster0.mongodb.net/ayupulse?retryWrites=true&w=majority
DATABASE_NAME=ayupulse

# JWT Configuration
SECRET_KEY=your_secure_random_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (update with your Vercel frontend URL)
BACKEND_CORS_ORIGINS=https://ayupulse.vercel.app,http://localhost:5173

# Application Settings
PROJECT_NAME=AyuPulseApp
DEBUG=False

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/jpg"]

# ML Model Paths
XRAY_MODEL_PATH=./ml/models/xray_model.pth
ECG_MODEL_PATH=./ml/models/ecg_model.pth
CLINICAL_MODEL_PATH=./ml/models/clinical_model.pkl

# Port (Railway sets this automatically)
PORT=8000

# Optional: Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@ayupulse.com